{
  "name": "chessup",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "worker:dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p src/worker",
    "test:api": "vitest run --config vitest.api.config.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "wrangler": "^4.165.0"
  },
  "dependencies": {
    "hono": "^4.13.19",
    "zod": "^4.6.7"
  }
}